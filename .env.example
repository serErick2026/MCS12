# Copy this file to .env for local development. Never commit .env.
# Values here are PLACEHOLDERS only. Replace them with values from your Supabase project.

# Browser-safe Supabase settings (publishable/anon key only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend-only secret for Cloudflare Pages Functions / Worker secrets.
# Never expose this in src/ or public/ browser code.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
