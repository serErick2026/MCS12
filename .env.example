# Copy this file to .env for local development. Never commit .env.
# Values here are PLACEHOLDERS only. Replace them with values from your Supabase project.

# Browser-safe Supabase settings (publishable/anon key only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend-only secret for Cloudflare Pages Functions / Worker secrets.
# Never expose this in src/ or public/ browser code.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cloudflare (optional - read by scripts/deploy-pages.mjs for `npm run deploy`).
# Create at https://dash.cloudflare.com/profile/api-tokens with
# Account > Cloudflare Pages > Edit for the target account.
# CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
